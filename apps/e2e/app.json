{
	"expo": {
		"name": "e2e",
		"slug": "e2e",
		"version": "0.0.1",
		"scheme": "e2e",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.eds2002.e2e",
			"appleTeamId": "5743WD6SWX"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE"
			},
			"predictiveBackGestureEnabled": false,
			"package": "com.eds2002.e2e"
		},
		"web": {
			"output": "static"
		},
		"plugins": [
			"expo-router",
			"expo-video",
			"expo-web-browser",
			[
				"expo-build-properties",
				{
					"ios": {
						"deploymentTarget": "16.4"
					},
					"android": {
						"minSdkVersion": 33
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
