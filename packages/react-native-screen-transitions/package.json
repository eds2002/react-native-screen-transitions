{
	"name": "react-native-screen-transitions",
	"version": "3.9.0-alpha.0",
	"description": "Easy screen transitions for React Native and Expo",
	"author": "Ed",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/eds2002/react-native-screen-transitions.git",
		"directory": "packages/react-native-screen-transitions"
	},
	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/eds2002"
		},
		{
			"type": "individual",
			"url": "https://buymeacoffee.com/trpfsu"
		}
	],
	"main": "lib/commonjs/index.js",
	"module": "lib/module/index.js",
	"types": "lib/typescript/index.d.ts",
	"react-native": "src/index",
	"exports": {
		".": {
			"react-native": "./src/index.ts",
			"import": "./lib/module/index.js",
			"require": "./lib/commonjs/index.js",
			"types": "./lib/typescript/index.d.ts"
		},
		"./react-navigation": {
			"react-native": "./src/navigators/react-navigation/index.tsx",
			"import": "./lib/module/navigators/react-navigation/index.js",
			"require": "./lib/commonjs/navigators/react-navigation/index.js",
			"types": "./lib/typescript/navigators/react-navigation/index.d.ts"
		},
		"./expo-router": {
			"react-native": "./src/navigators/expo-router/index.tsx",
			"import": "./lib/module/navigators/expo-router/index.js",
			"require": "./lib/commonjs/navigators/expo-router/index.js",
			"types": "./lib/typescript/navigators/expo-router/index.d.ts"
		}
	},
	"scripts": {
		"build": "rm -rf lib && bob build",
		"lint": "biome check ./src",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"prepublishOnly": "bun run build"
	},
	"keywords": [
		"react-native",
		"transitions",
		"animation",
		"react-navigation",
		"expo-router",
		"reanimated"
	],
	"files": [
		"lib",
		"src",
		"!src/**/__tests__",
		"!src/**/typecheck/**",
		"!lib/**/__tests__",
		"!lib/**/typecheck/**",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@react-navigation/native": ">=7.3.0",
		"@types/react": "*",
		"@types/react-native": "*",
		"expo-router": ">=56.2.10",
		"react": "*",
		"react-native": "*",
		"react-native-gesture-handler": ">=2.16.1",
		"react-native-reanimated": ">=3.16.0 || >=4.0.0-",
		"react-native-safe-area-context": "*",
		"react-native-screens": ">=4.4.0",
		"react-native-teleport": ">=1.1.0 <2.0.0"
	},
	"peerDependenciesMeta": {
		"expo-router": {
			"optional": true
		}
	},
	"dependencies": {
		"standard-navigation": "^0.0.7"
	},
	"devDependencies": {
		"@react-navigation/native": "7.3.3",
		"@testing-library/react-native": "13.3.3",
		"@types/react": "~19.1.0",
		"expo-router": "56.2.11",
		"react-native-builder-bob": "0.41.0",
		"react-test-renderer": "19.1.0",
		"typescript": "catalog:"
	},
	"react-native-builder-bob": {
		"source": "src",
		"output": "lib",
		"targets": [
			"commonjs",
			"module",
			[
				"typescript",
				{
					"project": "tsconfig.build.json"
				}
			]
		]
	},
	"gitHead": "888d4df9936ec0e3b8221bea7cd81115e6301693"
}
